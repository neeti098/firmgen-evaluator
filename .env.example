# Local production configuration. Paste only your own key after OPENAI_API_KEY=.
# Do not commit this file or share it.
OPENAI_API_KEY=
GITHUB_TOKEN=

# Dashboard login. Change both before use.
APP_PASSWORD=change-this-to-a-strong-dashboard-password
SESSION_SECRET=replace-this-with-a-long-random-secret

# OpenAI scoring configuration.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_ADJUDICATOR_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
MAX_CONCURRENT_EVALUATIONS=10
ADJUDICATE_LOW_CONFIDENCE=false
ADJUDICATION_CONFIDENCE_THRESHOLD=0.65

# Repository and media limits.
MAX_REPO_ARCHIVE_MB=50
MAX_REPO_TEXT_CHARS=120000
MAX_MEDIA_MB=200
MAX_README_IMAGES=8
MAX_VIDEO_FRAMES=16
MAX_VIDEOS=2

# Use false for real scoring. Set true only to test the UI without an OpenAI call.
MOCK_OPENAI=false
DATA_DIR=./data
